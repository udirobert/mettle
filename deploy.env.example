# Set these in Coolify. Never commit a real production environment file.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Leave empty for OpenAI. Set an OpenAI-compatible endpoint when using another
# provider, for example https://api.venice.ai/api/v1.
OPENAI_BASE_URL=

# Optional. Enables "Research public pages" in Coach: a recorded Solari cloud
# browser reads user-named URLs and every claim links to its replay. Leave
# empty to hide the option entirely. Keys: console.getsolari.com
SOLARI_API_KEY=

# Use a URL-safe generated value (letters and digits only) for this password.
POSTGRES_PASSWORD=

# Comma-separated browser origins. Include the Vercel production hostname and
# any approved preview host used for the client demo.
CORS_ALLOWED_ORIGINS=https://mettle.vercel.app
